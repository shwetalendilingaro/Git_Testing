model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: it-IT
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Customer","Date","Product","Product Category","Product Subcategory","Sales"]

annotation PBI_ProTooling = ["DevMode"]

ref table Customer
ref table Date
ref table Product
ref table Sales

ref cultureInfo en-US

